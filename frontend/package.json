{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "files": [
    "dist",
    "nginx"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "rimraf dist coverage",
    "check-types": "tsc -b --pretty --noEmit",
    "lint": "eslint --max-warnings=0 --cache --cache-location=node_modules/.cache/.eslintcache .",
    "format": "prettier --write --cache .",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest --coverage --ui"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "^5.90.24",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-persist-client": "^5.90.24",
    "classnames": "^2.5.1",
    "d3": "^7.9.0",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.2",
    "lz-string": "^1.5.0",
    "react": "^19.2.4",
    "react-compiler-runtime": "19.1.0-rc.3",
    "react-dom": "^19.2.4",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-hotkeys-hook": "^5.2.4",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vitest/ui": "^4.0.18",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-dom": "^2.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^2.13.0",
    "eslint-plugin-testing-library": "^7.16.0",
    "globals": "^17.4.0",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{js, jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix --cache --cache-location=node_modules/.cache/.eslintcache"
    ],
    "src/**/*.{json,js,ts,jsx,tsx,html,css}": [
      "prettier --write --ignore-unknown --cache"
    ]
  }
}
