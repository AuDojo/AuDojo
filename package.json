{
  "name": "audojo",
  "version": "1.0.0",
  "description": "## Todo",
  "main": "index.js",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm -r build",
    "clean": "rimraf test-results playwright-report && pnpm -r clean",
    "start": "pnpm --filter backend start",
    "dev": "pnpm -r dev",
    "check-types": "pnpm -r check-types",
    "lint:e2e": "eslint --flag unstable_config_lookup_from_file e2e --cache --cache-location=node_modules/.cache/.eslintcache --max-warnings=0",
    "lint": "pnpm --filter frontend lint && pnpm lint:e2e",
    "test": "pnpm --filter frontend test",
    "e2e": "pnpm playwright test",
    "coverage": "pnpm --filter frontend coverage",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@commitlint/types": "^20.4.3",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.3.3",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.2",
    "eslint-plugin-playwright": "^2.9.0",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.56.1"
  },
  "optionalDependencies": {
    "husky": "^9.1.7"
  },
  "type": "module",
  "packageManager": "pnpm@10.30.3"
}
