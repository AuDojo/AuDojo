{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "files": [
    "dist",
    "nginx"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "clean": "rimraf dist coverage",
    "check-types": "tsc -b --pretty --noEmit",
    "lint": "eslint --max-warnings=0 --cache --cache-location=node_modules/.cache/.eslintcache .",
    "format": "prettier --write --cache .",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest --coverage --ui"
  },
  "dependencies": {
    "@tanstack/query-sync-storage-persister": "^5.79.0",
    "@tanstack/react-query": "^5.79.0",
    "@tanstack/react-query-devtools": "^5.79.0",
    "@tanstack/react-query-persist-client": "^5.79.0",
    "classnames": "^2.5.1",
    "d3": "^7.9.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.1.0",
    "i18next-http-backend": "^3.0.2",
    "lz-string": "^1.5.0",
    "react": "^19.1.0",
    "react-compiler-runtime": "19.1.0-rc.2",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.57.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-i18next": "^15.5.2",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.6.1",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@tanstack/eslint-plugin-query": "^5.74.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.5.0",
    "@vitest/coverage-v8": "^3.1.4",
    "@vitest/eslint-plugin": "^1.2.1",
    "@vitest/ui": "^3.1.4",
    "babel-plugin-react-compiler": "19.1.0-rc.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-dom": "^1.49.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-react-x": "^1.49.0",
    "eslint-plugin-testing-library": "^7.2.1",
    "globals": "^16.1.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4"
  },
  "lint-staged": {
    "src/**/*.{js, jsx,ts,tsx}": [
      "eslint --max-warnings=0 --fix --cache --cache-location=node_modules/.cache/.eslintcache"
    ],
    "src/**/*.{json,js,ts,jsx,tsx,html,css}": [
      "prettier --write --ignore-unknown --cache"
    ]
  }
}
