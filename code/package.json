    "i18next-http-backend": "^3.0.1",
    "react-i18next": "^15.4.0",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "npm-run-all": "^4.1.5"
  }
